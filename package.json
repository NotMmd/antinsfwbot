{
  "name": "antinsfwbot-cloudflare-worker",
  "version": "1.0.0",
  "private": true,
  "type": "module",
  "scripts": {
    "dev": "wrangler dev",
    "deploy": "wrangler deploy",
    "db:create": "wrangler d1 create antinsfwbot-db",
    "db:migrate:local": "wrangler d1 migrations apply antinsfwbot-db --local",
    "db:migrate:remote": "wrangler d1 migrations apply antinsfwbot-db --remote"
  },
  "devDependencies": {
    "wrangler": "^4.0.0"
  }
}
